# Telegram bot token from @BotFather
BOT_TOKEN=your_bot_token_here

# PostgreSQL connection (DATABASE_URL can be used instead of these fields)
# DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5432/marketbot
DB_NAME=marketbot
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# Telegram user IDs allowed to administer the bot (comma-separated)
ADMIN_IDS=your_telegram_user_id

# Admin panel credentials
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_admin_password

# Replace with a long, random secret before deploying
SECRET_KEY=your_long_random_secret_key

# Optional public URL of the web app; WEB_BASE_URL is a supported fallback
PUBLIC_BASE_URL=https://your-domain.example
# WEB_BASE_URL=https://your-domain.example
